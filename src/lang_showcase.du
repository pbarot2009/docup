package com.docup.stream

import kotlinx.coroutines.flow.Flow
import kotlinx.coroutines.flow.flow

fun emitNumbers(): Flow<Int> = flow {
    for (i in 1..10) {
        emit(i * 2)
    }
}
!}

p { C# asynchronous LINQ records: }

codeblock(lang: "csharp", file: "RecordService.cs", line_numbers: true, highlight: "3,7") {!
using System;
using System.Threading.Tasks;

public record UserProfile(Guid Id, string Username, bool IsActive);

public class UserService {
    public async Task<UserProfile> GetProfileAsync(Guid id) {
        await Task.Delay(10);
        return new UserProfile(id, "docup_dev", true);
    }
}
!}

p { Swift actors with async/await concurrency: }

codeblock(lang: "swift", file: "Bank.swift", line_numbers: true) {!
actor BankAccount {
    private var balance: Double = 0.0

    func deposit(amount: Double) {
        guard amount > 0 else { return }
        balance += amount
    }

    func getBalance() -> Double {
        return balance
    }
}
!}

