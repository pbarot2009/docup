meta {
    title: "DocUP 65-Language Highlighting Verification",
    author: "DocUP Engine",
    version: "0.2.0",
    theme: "dark",
    lang: "en"
}

h(1) { Complete 65-Language Syntax Highlighting Test Suite }

p {
    This suite validates tokenization, keywords, types, strings, comments, and
    line numbering across all 65 supported languages.
}

toc {}

hr {}

h(2) { 1. Systems & Low-Level }

p {
    Zig
}

codeblock(lang: "zig", line_numbers: true) {!
// Zig error-union and allocator
const std = @import("std");
pub fn main() !void {
    const mem = try std.heap.page_allocator.alloc(u8, 64);
    defer std.heap.page_allocator.free(mem);
}
!}

p {
    Odin
}

codeblock(lang: "odin", line_numbers: true) {!
// Odin procedure definition
package main
import "core:fmt"
Vector2 :: struct { x, y: f32 }
main :: proc() { fmt.println("Odin ok", 42) }
!}

p {
    Nim
}

codeblock(lang: "nim", line_numbers: true) {!
#[ Nim block comment ]#
import std/strformat
type State* = object
  id: int
proc run*(s: State): bool = true
!}

p {
    D
}

codeblock(lang: "d", line_numbers: true) {!
import std.stdio;
void main() {
    string msg = `Raw string literal`;
    writeln(msg, 1024);
}
!}

p {
    Rust
}

codeblock(lang: "rust", line_numbers: true) {!
// Rust pattern matching
pub fn check(val: Option<i32>) -> Result<u64, &'static str> {
    match val { Some(n) if n > 0 => Ok(n as u64), _ => Err("failed") }
}
!}

p {
    C
}

codeblock(lang: "c", line_numbers: true) {!
#include <stdbool.h>
typedef unsigned long size_t;
const int MAX_LIMIT = 512;
bool init(char* buffer, size_t len);
!}

p {
    C++
}

codeblock(lang: "cpp", line_numbers: true) {!
#include <concepts>
template<typename T>
concept Numeric = std::is_integral_v<T>;
auto add(Numeric auto a, Numeric auto b) -> decltype(a + b) { return a + b; }
!}

p {
    Go
}

codeblock(lang: "go", line_numbers: true) {!
package main
func Worker(done chan bool, tasks map[string]int) {
    defer close(done)
    for k, v := range tasks { println(k, v) }
}
!}

