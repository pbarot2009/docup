h(2) { 6. Shell, Build & DevOps }

p {
    Bash
}

codeblock(lang: "bash", line_numbers: true) {!
#!/usr/bin/env bash
set -e
readonly TARGET_DIR="./dist"
for file in "$TARGET_DIR"/*.tar.gz; do echo "Extracting $file"; done
!}

