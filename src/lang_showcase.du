h(2) { 8. Hardware Description & Assembly }

p {
    x86_64 / ARM Assembly
}

codeblock(lang: "assembly", line_numbers: true) {!
; Assembly routine
section .text
global _start
_start:
    mov rax, 1
    mov rdi, 0
    syscall
!}

p {
    VHDL
}

codeblock(lang: "vhdl", line_numbers: true) {!
-- VHDL Entity
library IEEE;
use IEEE.STD_LOGIC_1164.ALL;
entity mux is
    port (sel: in std_logic; a, b: in std_logic; y: out std_logic);
end mux;
!}

p {
    Verilog
}

codeblock(lang: "verilog", line_numbers: true) {!
// Verilog module
module counter(input wire clk, input wire rst, output reg [3:0] q);
    always @(posedge clk or posedge rst)
        if (rst) q <= 4'b0000; else q <= q + 1;
endmodule
!}

p {
    SystemVerilog
}

codeblock(lang: "systemverilog", line_numbers: true) {!
// SystemVerilog interface
interface BusIf(input logic clk);
    logic [31:0] data;
    logic ready;
    modport Master(input ready, output data);
endinterface
!}

