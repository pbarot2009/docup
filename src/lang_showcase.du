!}

p {
    Scheme
}

codeblock(lang: "scheme", line_numbers: true) {!
;; Scheme recursive factorial
(define (fact n)
  (if (<= n 1) 1 (* n (fact (- n 1)))))
!}

p {
    Elm
}

codeblock(lang: "elm", line_numbers: true) {!
-- Elm model-view-update
type Msg = Increment | Decrement
update : Msg -> Int -> Int
update msg model = case msg of Increment -> model + 1; Decrement -> model - 1
!}

p {
    PureScript
}

codeblock(lang: "purescript", line_numbers: true) {!
-- PureScript effectful computation
module Main where
import Effect (Effect)
main :: Effect Unit
main = pure unit
!}

p {
    Standard ML
}

codeblock(lang: "sml", line_numbers: true) {!
(* SML signature and structure *)
signature QUEUE = sig type 'a queue val empty : 'a queue end;
structure Q : QUEUE = struct type 'a queue = 'a list val empty = [] end;
!}

