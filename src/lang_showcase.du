h(2, id: "build-config") { 6. Build Systems, Containers & Shells }

p { PowerShell administration script: }

codeblock(lang: "powershell", file: "deploy.ps1", line_numbers: true) {!
# Automated container cluster configuration
param (
    [string]$Environment = "Production",
    [int]$Replicas = 3
)

Write-Host "Deploying to $Environment with $Replicas nodes"
if ($Replicas -lt 1) {
    throw "Invalid replica count specified."
}
!}

p { Dockerfile multi-stage build: }

codeblock(lang: "dockerfile", file: "Dockerfile", line_numbers: true) {!
FROM rust:1.80-alpine AS builder
WORKDIR /app
COPY . .
RUN cargo build --release

FROM alpine:latest
WORKDIR /root/
COPY --from=builder /app/target/release/docup /usr/local/bin/
CMD ["docup", "--help"]
!}

