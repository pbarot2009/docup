h(2, id: "systems-languages") { 1. Modern Systems Programming }

p { Zig allocator initialization and error handling: }

codeblock(lang: "zig", file: "allocator.zig", line_numbers: true, highlight: "4,6") {!
const std = @import("std");

pub fn main() !void {
    var gpa = std.heap.GeneralPurposeAllocator(.{}){};
    defer _ = gpa.deinit();
    const allocator = gpa.allocator();

    const bytes = try allocator.alloc(u8, 1024);
    defer allocator.free(bytes);
}
!}

p { Odin procedure declarations and context tracking: }

codeblock(lang: "odin", file: "math.odin", line_numbers: true) {!
package math

import "core:fmt"

Vector3 :: struct {
    x, y, z: f32,
}

normalize :: proc(v: Vector3) -> (Vector3, bool) {
    if v.x == 0 && v.y == 0 && v.z == 0 {
        return v, false
    }
    return v, true
}
!}

p { Nim metaprogramming and block comments: }

codeblock(lang: "nim", file: "cache.nim", line_numbers: false) {!
#[
  Thread-safe in-memory cache
  with automatic eviction policies
]#
import tables, locks

type
  Cache*[K, V] = object
    data: Table[K, V]
    lock: Lock

proc initCache*[K, V](): Cache[K, V] =
  initLock(result.lock)
  result.data = initTable[K, V]()
!}

p { D language range algorithms: }

codeblock(lang: "d", file: "stream.d", line_numbers: true) {!
import std.stdio;
import std.algorithm : map, filter;

void main() {
    int[] numbers = [1, 2, 3, 4, 5, 6];
    auto evens = numbers.filter!(n => n % 2 == 0);
    writeln(evens);
}
!}

