h(2) { 2. Functional & Declarative }

p {
    Haskell
}

codeblock(lang: "haskell", line_numbers: true) {!
-- Haskell type signature and monad
safeHead :: [a] -> Maybe a
safeHead [] = Nothing
safeHead (x:_) = Just x
!}

p {
    OCaml
}

codeblock(lang: "ocaml", line_numbers: true) {!
(* OCaml variant pattern *)
type 'a tree = Leaf | Node of 'a * 'a tree * 'a tree
let rec depth = function Leaf -> 0 | Node (_, l, r) -> 1 + max (depth l) (depth r)
!}

p {
    Elixir
}

codeblock(lang: "elixir", line_numbers: true) {!
defmodule Calc do
  @impl true
  def run(val) when is_integer(val), do: {:ok, val * 2}
end
!}

p {
    Erlang
}

codeblock(lang: "erlang", line_numbers: true) {!
% Erlang actor loop
loop() ->
    receive {msg, From} -> From ! ok, loop(); stop -> ok end.
!}

p {
    Clojure
}

codeblock(lang: "clojure", line_numbers: true) {!
;; Clojure thread-safe state
(defn update-state [state-atom delta]
  (swap! state-atom + delta))
!}

p {
    F#
}

codeblock(lang: "fsharp", line_numbers: true) {!
// F# Async workflow
