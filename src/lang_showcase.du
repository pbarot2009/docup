h(2, id: "functional-languages") { 2. Functional & Declarative Languages }

p { Haskell monadic parser combinator: }

codeblock(lang: "haskell", file: "Parser.hs", line_numbers: true) {!
-- Monadic parsing unit
module Parser (Parser, runParser) where

newtype Parser a = Parser { runParser :: String -> Maybe (a, String) }

instance Functor Parser where
    fmap f (Parser p) = Parser $ \input -> do
        (x, rest) <- p input
        return (f x, rest)
!}

p { OCaml variant types and recursive pattern matching: }

codeblock(lang: "ocaml", file: "expr.ml", line_numbers: true) {!
(* Expression abstract syntax tree *)
type expr =
  | Const of int
  | Add of expr * expr
  | Mul of expr * expr

let rec eval = function
  | Const n -> n
  | Add (e1, e2) -> eval e1 + eval e2
  | Mul (e1, e2) -> eval e1 * eval e2
!}

p { Elixir supervision tree: }

codeblock(lang: "elixir", file: "worker.ex", line_numbers: true) {!
defmodule Core.Worker do
  use GenServer

  def start_link(initial_state) do
    GenServer.start_link(__MODULE__, initial_state, name: __MODULE__)
  end

  @impl true
  def init(state), do: {:ok, state}
end
!}

p { Clojure concurrency using atoms and swaps: }

codeblock(lang: "clojure", file: "state.clj", line_numbers: false) {!
;; Thread-safe counter atom
(ns app.state)

(defonce app-counter (atom 0))

(defn increment-counter [step]
  (swap! app-counter + step))
!}

