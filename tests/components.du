h(3) { Multiline Matrix & Integral Formulations }

math {!
\begin{bmatrix}
\cos\theta & -\sin\theta \\
\sin\theta & \cos\theta
\end{bmatrix}
\begin{bmatrix}
x \\
y
\end{bmatrix}
=
\begin{bmatrix}
x \cos\theta - y \sin\theta \\
x \sin\theta + y \cos\theta
\end{bmatrix}
!}

footnote(id: "unicode-spec") {
    The Unicode Standard, Version 15.0 — Core Specification regarding
    multi-byte UTF-8 token boundaries.
}

footnote(id: "algo-complexity") {
    Theoretical computational complexity guarantees linear $O(N)$ execution
    across lexer and parser stages.
}
