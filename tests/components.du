h(3) { Multi-Language Code Highlighting }

p {
    Python highlighting with hash comment handling and string parsing:
}

codeblock(lang: "python", file: "benchmark.py", line_numbers: true, highlight: "4,7") {!
import time
from typing import List

def run_pipeline(sources: List[str]) -> float:
    # Measure total compilation pipeline duration
    start = time.perf_counter()
    for doc in sources:
        print(f"Processing: {doc}")
    return time.perf_counter() - start
!}

