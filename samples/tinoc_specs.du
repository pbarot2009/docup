h(2, id: "optional-type") { Optional Type }

table {
    row(header: true) {
        cell { b{Tinoc Type} }
        cell { b{C Equivalent} }
        cell { b{Category} }
    }
    row {
        cell { code{?T} }
        cell { code{struct { T value; bool has_value; }} }
        cell { Optional (nullable wrapper) }
    }
}

p { No direct C equivalent. Represented as: }

codeblock(lang: "c") {!
typedef struct {
    T value;
    bool has_value;
} optional_T;
!}

h(2, id: "error-union-types") { Error Union Types }

table {
    row(header: true) {
        cell { b{Tinoc Type} }
        cell { b{C Equivalent} }
        cell { b{Category} }
    }
    row {
        cell { code{!T} }
        cell { code{struct { T value; int err; bool is_err; }} }
        cell { Inferred Error Union }
    }
    row {
        cell { code{E!T} }
        cell { code{struct { T value; E err; bool is_err; }} }
        cell { Explicit Error Union }
    }
}

p { No direct C equivalent for either. General pattern: }

codeblock(lang: "c") {!
typedef struct {
    T value;
    E err;      // error code/enum
    bool is_err;
} result_T;
!}

