h(2, id: "string-type") { String Type }

p { code{str} has no direct C primitive equivalent. It is represented as a C struct: }

codeblock(lang: "c") {!
typedef struct {
    const char* data;
    size_t len;
} str;
!}

table {
    row(header: true) {
        cell { b{Tinoc Type} }
        cell { b{C Equivalent} }
        cell { b{Category} }
    }
    row {
        cell { code{str} }
        cell { code{struct { const char* data; size_t len; }} }
        cell { String (struct) }
    }
}

h(2, id: "array-and-slice-types") { Array & Slice Types }

table {
    row(header: true) {
        cell { b{Tinoc Type} }
        cell { b{C Equivalent} }
        cell { b{Category} }
    }
    row {
        cell { code{[N]T} }
        cell { code{T arr[N]} }
        cell { Fixed-size Array }
    }
    row {
        cell { code{[_]T} }
        cell { code{T arr[N]} i{(size inferred by compiler)} }
        cell { Inferred-size Array }
    }
    row {
        cell { code{[]T} }
        cell { code{struct { T* ptr; size_t len; }} }
        cell { Slice (fat pointer struct) }
    }
}

p { code{[]T} has no direct C equivalent. Represented as: }

codeblock(lang: "c") {!
typedef struct {
    T* ptr;
    size_t len;
} slice_T;
!}

