# Generated by Cargo
# Contains all build artifacts, dependencies, test binaries, and compiler cache
/target/

# Windows debug symbols and native binaries (if placed outside target/)
*.pdb
*.exe
*.exe~
*.dll
*.so
*.dylib

# Rust test & coverage artifacts (cargo-tarpaulin, llvm-cov, profraw)
*.profraw
*.profdata
*.out
coverage/
lcov.info
cobertura.xml

# Rustfmt backup files
**/*.rs.bk

# Cargo local credentials / secret configurations
# Note: Keep .cargo/config.toml committed if it only has project flags;
# uncomment if you store machine-specific settings or credentials.
# .cargo/config.toml
.cargo/credentials.toml

# Cargo.lock:
# For CLI applications and standalone binaries (like docup), Cargo.lock
# SHOULD be committed to version control to guarantee reproducible builds.
# If you decide to distribute this purely as a library, uncomment the line below:
# Cargo.lock

# Environment variables
.env

# Editor & IDE configurations
.idea/
.vscode/
*.swp
*.swo
*~
